{
  "name": "citywatch",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios --localhost",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:activity": "node --experimental-strip-types --test tests/activity-session.test.ts",
    "test:occurrences": "node --experimental-strip-types --test tests/occurrence-draft.test.ts",
    "postinstall": "patch-package",
    "dev": "node scripts/dev.mjs",
    "ios:native": "node scripts/ios-native.mjs",
    "test:connection": "node --experimental-strip-types --test tests/api-connection.test.ts",
    "test:events": "node --experimental-strip-types --test tests/events.test.ts",
    "test:discovery": "node --experimental-strip-types --test tests/discovery.test.ts",
    "test:map": "node --experimental-strip-types --test tests/map-interactive.test.ts",
    "test:agenda": "node --experimental-strip-types --test tests/agenda-calendar.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-calendar": "~58.0.8",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-sensors": "~58.0.5",
    "expo-speech-recognition": "58.0.1",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
